    "type": "git",
    "url": "git+https://github.com/float3/float3.github.io.git",
    "directory": "wasm/bundle"
  },
  "keywords": [
    "webassembly",
    "wasm",
    "rust",
    "webpack"
  ],
  "author": "hill <hill@hilll.dev>",
  "license": "AGPL-3.0-only",
  "bugs": {
    "url": "https://github.com/float3/float3.github.io/issues"
  },
  "homepage": "https://github.com/float3/float3.github.io#readme",
  "dependencies": {
    "wasm-aoc": "file:../wasm/wasm/pkg/aoc",
    "wasm-bayes": "file:../wasm/wasm/pkg/bayes",
    "wasm-chars": "file:../wasm/wasm/pkg/chars",
    "wasm-doom": "^1.2.0",
    "wasm-gallery": "file:../wasm/wasm/pkg/gallery",
    "wasm-glsl": "file:../wasm/wasm/pkg/glsl",
    "wasm-movies": "file:../wasm/wasm/pkg/movies",
    "wasm-photography": "file:../wasm/wasm/pkg/photography",
    "wasm-polyrhythm": "file:../wasm/wasm/pkg/polyrhythm",
